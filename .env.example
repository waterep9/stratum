# ---- Stratum 运行配置（全部通过环境变量注入）----
# 数据目录：元数据库 + 分片 CAS + 分片上传暂存区
STRATUM_DATA_DIR=./data
# 元数据库路径，默认 ${STRATUM_DATA_DIR}/stratum.db
# STRATUM_DB_PATH=./data/stratum.db
# 管理令牌：可创建 bucket、签发访问密钥、触发维护任务
STRATUM_ADMIN_TOKEN=change-me-admin-token
# 分片大小（字节），默认 1 MiB
STRATUM_CHUNK_SIZE=1048576
# 未引用分片的回收宽限期（秒），必须大于单次上传耗时，避免误删在途分片
STRATUM_GC_GRACE_SECONDS=900
# 单对象大小上限（字节），默认 256 MiB；0 表示不限制
STRATUM_MAX_OBJECT_BYTES=268435456
# 预签名 URL 的默认有效期（秒）
STRATUM_PRESIGN_TTL=900
# 后台 worker 的轮询间隔（秒）
STRATUM_WORKER_INTERVAL=5
# 控制台与公开 API 的基础地址，用于拼接预签名绝对链接
STRATUM_PUBLIC_BASE_URL=http://127.0.0.1:8080
